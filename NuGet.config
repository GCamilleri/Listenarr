<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pin this repository to nuget.org only. Without this, restore inherits whatever
    feeds happen to be in the machine-level NuGet config, which triggers NU1507 under
    central package management and lets packages resolve from unrelated private feeds.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
